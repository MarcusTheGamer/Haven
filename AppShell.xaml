<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Haven.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Haven.Views"
    Title="Haven"
    BackgroundColor="{StaticResource BackgroundSecondary}">

    <ShellContent
        ContentTemplate="{DataTemplate local:LoginPage}"
        Route="LoginPage" />

    <ShellContent
        ContentTemplate="{DataTemplate local:FamilySetupPage}"
        Route="FamilySetupPage" />

    <TabBar>
        <ShellContent
            Title="Find Device"
            Icon="scan.png"
            ContentTemplate="{DataTemplate local:FindDevicesPage}"
            Route="FindDevicesPage" />

        <ShellContent
            Title="Home"
            Icon="home.png"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />

        <ShellContent
            Title="Profile"
            Icon="user.png"
            ContentTemplate="{DataTemplate local:ProfilePage}"
            Route="ProfilePage"/>
    </TabBar>
</Shell>