    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Haven"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Title="Haven"
    BackgroundColor="{StaticResource BackgroundSecondary}">

    <Tab>
        <ShellContent
            Title="Home"
            Icon="lock.png"
