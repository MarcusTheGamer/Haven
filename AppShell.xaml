<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Haven.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Haven.Views"
    Title="Haven"
    BackgroundColor="{StaticResource BackgroundSecondary}">

    <ShellContent
        ContentTemplate="{DataTemplate local:LoginPage}"
        Route="LoginPage" />
    
    <TabBar>
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />

        <ShellContent
            Title="Find Device"
            ContentTemplate="{DataTemplate local:FindDevicesPage}"
            Route="FindDevicesPage" />

        <ShellContent
            Title="Device Details"
            ContentTemplate="{DataTemplate local:DeviceDetailsPage}"
            Route="DeviceDetailsPage" />

        <ShellContent
            Title="Manage Family"
            ContentTemplate="{DataTemplate local:ManageFamilyPage}"
            Route="ManageFamilyPage" />
    </TabBar>

</Shell>