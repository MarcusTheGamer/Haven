<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Haven.Devices.DeviceBricks.BaseBrick">
    <Border Style="{StaticResource BrickSingle}">
        <VerticalStackLayout Style="{StaticResource BrickVertStackLayout}">
            <HorizontalStackLayout Style="{StaticResource BrickHorzStackLayout}">
                <Border Style="{StaticResource IconBorder}">
                    <Image Source="sun.png"/>
                </Border>
                <Label Style="{StaticResource BrickHeaderText}">Living Room</Label>
            </HorizontalStackLayout>
            <ContentPresenter/>
        </VerticalStackLayout>
    </Border>
</ContentView>
