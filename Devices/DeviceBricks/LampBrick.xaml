<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:bricks="clr-namespace:Haven.Devices.DeviceBricks"
             x:Class="Haven.Devices.DeviceBricks.LampBrick"
             x:Name="root">
    <bricks:BaseBrick
        IconSource="sun.png"
        Title="{Binding Title, Source={x:Reference root}}">
        <VerticalStackLayout Spacing="6">
            <HorizontalStackLayout Spacing="10">
                <Label Style="{StaticResource ContentText}" Text="Power" VerticalOptions="Center"/>
                <Switch x:Name="PowerSwitch" Toggled="OnPowerToggled"/>
            </HorizontalStackLayout>
            <Slider x:Name="RedSlider" Maximum="255" ValueChanged="OnColorPreview" DragCompleted="OnColorCommitted"/>
            <Slider x:Name="GreenSlider" Maximum="255" ValueChanged="OnColorPreview" DragCompleted="OnColorCommitted"/>
            <Slider x:Name="BlueSlider" Maximum="255" ValueChanged="OnColorPreview" DragCompleted="OnColorCommitted"/>
            <BoxView x:Name="Swatch" HeightRequest="16" CornerRadius="8"/>
        </VerticalStackLayout>
    </bricks:BaseBrick>
</ContentView>