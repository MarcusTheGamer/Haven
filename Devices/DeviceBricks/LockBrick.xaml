<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:bricks="clr-namespace:Haven.Devices.DeviceBricks"
             x:Class="Haven.Devices.DeviceBricks.LockBrick"
             x:Name="root">
    <bricks:BaseBrick x:Name="Host"
        Title="{Binding Title, Source={x:Reference root}}"
        BrickStyle="{StaticResource BrickDoubleSlim}">
        <Label x:Name="StatusLabel" Style="{StaticResource ContentText}"/>
    </bricks:BaseBrick>
</ContentView>