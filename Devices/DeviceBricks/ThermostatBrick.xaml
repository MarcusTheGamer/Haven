<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:bricks="clr-namespace:Haven.Devices.DeviceBricks"
             xmlns:gauge="clr-namespace:Syncfusion.Maui.Gauges;assembly=Syncfusion.Maui.Gauges"
             x:Class="Haven.Devices.DeviceBricks.ThermostatBrick"
             x:Name="root">
    <bricks:BaseBrick
        IconSource="{Binding IconSource, Source={x:Reference root}}"
        Title="{Binding Title, Source={x:Reference root}}">
        <gauge:SfRadialGauge BackgroundColor="Transparent" WidthRequest="100" HeightRequest="100">
            <gauge:SfRadialGauge.Axes>
                <gauge:RadialAxis Minimum="0"
                                   Maximum="{Binding GaugeMax, Source={x:Reference root}}"
                                   Interval="10" StartAngle="270" EndAngle="180"
                                   ShowLabels="False" ShowTicks="False" ShowAxisLine="False">
                    <gauge:RadialAxis.Ranges>
                        <gauge:RadialRange StartValue="0" EndValue="{Binding GaugeValue, Source={x:Reference root}}"/>
                    </gauge:RadialAxis.Ranges>
                    <gauge:RadialAxis.Annotations>
                        <gauge:GaugeAnnotation PositionFactor="0" DirectionUnit="AxisValue" DirectionValue="50">
                            <gauge:GaugeAnnotation.Content>
                                <HorizontalStackLayout>
                                    <Label Text="{Binding GaugeValue, Source={x:Reference root}}" Style="{StaticResource ImportantText}"/>
                                    <Label Text="°C" Style="{StaticResource ContentTextBold}"/>
                                </HorizontalStackLayout>
                            </gauge:GaugeAnnotation.Content>
                        </gauge:GaugeAnnotation>
                    </gauge:RadialAxis.Annotations>
                </gauge:RadialAxis>
            </gauge:SfRadialGauge.Axes>
        </gauge:SfRadialGauge>
    </bricks:BaseBrick>
</ContentView>