<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:bricks="clr-namespace:Haven.Devices.DeviceBricks"
             x:Class="Haven.Devices.DeviceBricks.ToggleBrick"
             x:Name="root">
    <bricks:BaseBrick x:Name="Host"
        Title="{Binding Title, Source={x:Reference root}}">
        <Label Style="{StaticResource ContentText}" Text="{Binding StatusText, Source={x:Reference root}}"/>
    </bricks:BaseBrick>
</ContentView>