<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="BackgroundPrimary">#16262a</Color>
    <Color x:Key="BackgroundSecondary">#0f1417</Color>
    <Color x:Key="ForegroundPrimary">#171e22</Color>
    <Color x:Key="ForegroundSecondary">#2e2136</Color>
    <Color x:Key="ForegroundTertiary">#b09bbe</Color>
    <Color x:Key="BorderPrimary">#3a2c42</Color>

    <SolidColorBrush x:Key="BGPrimary" Color="{StaticResource BackgroundPrimary}"/>
    <SolidColorBrush x:Key="BGSecondary" Color="{StaticResource BackgroundSecondary}"/>
    <SolidColorBrush x:Key="FGPrimary" Color="{StaticResource ForegroundPrimary}"/>
    <SolidColorBrush x:Key="FGSecondary" Color="{StaticResource ForegroundSecondary}"/>
    <SolidColorBrush x:Key="FGTertiary" Color="{StaticResource ForegroundTertiary}"/>
    <SolidColorBrush x:Key="BPrimary" Color="{StaticResource BorderPrimary}"/>
</ResourceDictionary>