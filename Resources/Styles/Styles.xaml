<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style x:Key="BrickSingle" TargetType="Border">
        <Setter Property="MinimumHeightRequest" Value="160"/>
        <Setter Property="Margin" Value="6" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="BackgroundColor" Value="{StaticResource BorderPrimary}" />
    </Style>

    <Style x:Key="BrickDouble" TargetType="Border" BasedOn="{StaticResource BrickSingle}">
        <Setter Property="Grid.ColumnSpan" Value="2"/>
    </Style>

    <Style x:Key="BrickDoubleSlim" TargetType="Border" BasedOn="{StaticResource BrickDouble}">
        <Setter Property="MinimumHeightRequest" Value="100"/>
    </Style>

    <Style x:Key="DeviceBrickStackLayout" TargetType="VerticalStackLayout">
        <Setter Property="BackgroundColor" Value="{StaticResource ForegroundPrimary}" />
        <Setter Property="Padding" Value="10" />
    </Style>

</ResourceDictionary>