<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Haven.Views.AddDevicePage"
             Title="Add Device"
             BackgroundColor="{StaticResource BackgroundPrimary}">
    <Border>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{StaticResource BackgroundPrimary}" Offset="0.0"/>
                <GradientStop Color="{StaticResource BackgroundSecondary}" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Style="{StaticResource HeaderText}" Text="{Binding DeviceName}" FontSize="22"/>
            <Label Style="{StaticResource ContentText}" Text="Enter the Wi-Fi network this device should join."/>

            <Entry Placeholder="Wi-Fi name" Text="{Binding HomeSsid}"/>
            <Entry Placeholder="Wi-Fi password" Text="{Binding HomePassword}" IsPassword="True"/>

            <Button Text="Connect Device" Clicked="OnConnectClicked"/>

            <HorizontalStackLayout Spacing="8">
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" WidthRequest="15" HeightRequest="15" Color="{StaticResource Accent}"/>
                <Label Style="{StaticResource ContentText}" Text="{Binding StatusMessage}"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentPage>