<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Haven.ViewModels"
             x:Class="Haven.Views.CreateFamilyPage"
             x:DataType="viewmodels:CreateFamilyViewModel"
             Title="Create a Family"
             BackgroundColor="{StaticResource BackgroundPrimary}">
    <Grid>
        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" MaximumWidthRequest="280" Spacing="8">
            <Entry Style="{StaticResource AuthPageElement}" Placeholder="Home name (e.g. The Smiths)" Text="{Binding FamilyName}" />

            <Border Style="{StaticResource BorderBase}" Padding="12" BackgroundColor="{StaticResource ForegroundPrimary}">
                <VerticalStackLayout Spacing="2">
                    <Label Style="{StaticResource ContentTextBold}" Text="Network" />
                    <Label Style="{StaticResource ContentText}" Text="{Binding DetectedNetwork}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding ErrorMessage}" TextColor="Red" FontSize="12" />
            <Button Style="{StaticResource AuthPageElement}" Text="Create" Command="{Binding CreateCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>