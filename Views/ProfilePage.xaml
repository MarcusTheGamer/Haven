<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://schemas.microsoft.com/dotnet/2021/maui/design"
             xmlns:viewmodels="clr-namespace:Haven.ViewModels"
             x:Class="Haven.Views.ProfilePage"
             x:DataType="viewmodels:ProfileViewModel"
             BackgroundColor="{StaticResource BackgroundPrimary}"
             Title="Profile">

    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="gear.svg" Clicked="OnSettingsClicked" />
    </ContentPage.ToolbarItems>

    <Border>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{StaticResource BackgroundPrimary}" Offset="0.0" />
                <GradientStop Color="{StaticResource BackgroundSecondary}" Offset="1.0" />
            </LinearGradientBrush>
        </Border.Background>
        <ScrollView>
            <VerticalStackLayout Padding="12" Spacing="12">

                <Border Style="{StaticResource BorderBase}" BackgroundColor="{StaticResource ForegroundPrimary}">
                    <VerticalStackLayout Style="{StaticResource BrickVertStackLayout}" Spacing="12" Padding="20">

                        <Border StrokeShape="RoundRectangle 45"
                                StrokeThickness="2"
                                Stroke="{StaticResource BorderPrimary}"
                                BackgroundColor="{StaticResource ForegroundSecondary}"
                                HeightRequest="90"
                                WidthRequest="90"
                                Padding="20"
                                HorizontalOptions="Center">
                            <Image Source="user.png" />
                        </Border>

                        <ActivityIndicator IsRunning="{Binding IsLoading}"
                                            IsVisible="{Binding IsLoading}"
                                            HorizontalOptions="Center" />

                        <Label Text="{Binding FirstName}"
                               Style="{StaticResource ImportantText}"
                               HorizontalTextAlignment="Center"
                               HorizontalOptions="Center" />

                        <Label Text="{Binding Email}"
                               Style="{StaticResource ContentText}"
                               HorizontalTextAlignment="Center"
                               HorizontalOptions="Center" />

                        <Label Text="{Binding MemberSince}"
                               Style="{StaticResource ContentText}"
                               HorizontalTextAlignment="Center"
                               HorizontalOptions="Center" />

                        <Label Text="{Binding ErrorMessage}"
                               TextColor="Red"
                               FontSize="12"
                               HorizontalTextAlignment="Center"
                               HorizontalOptions="Center" />

                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource BorderBase}">
                    <Button Text="Log Out" Command="{Binding LogoutCommand}" Background="Transparent"/>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Border>
</ContentPage>